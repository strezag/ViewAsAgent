{
  "name": "viewasagent",
  "version": "0.2.0",
  "description": "See any web page the way an AI agent sees it.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixtures": "node fixtures/server.mjs",
    "fixtures:check": "node fixtures/selfcheck.mjs",
    "verify": "wxt build --mode development && node scripts/verify-headers.mjs",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "diff": "^9.0.0",
    "gpt-tokenizer": "^4.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/chrome": "^0.2.7",
    "@types/diff": "^7.0.2",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/turndown": "^5.0.6",
    "@wxt-dev/module-react": "^1.2.2",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wxt": "^0.21.4"
  }
}
